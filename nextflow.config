
manifest {
    description = 'Proof of concept of a RNA-seq pipeline implemented with Nextflow'
    author = 'Paolo Di Tommaso'
    nextflowVersion = '>=25.10.0'
}

/*
 * params for default test data
 */

params.reads = "${projectDir}/data/ggal/ggal_gut_{1,2}.fq"
params.transcriptome = "${projectDir}/data/ggal/ggal_1_48850000_49020000.Ggal71.500bpflank.fa"
params.multiqc = "${projectDir}/multiqc"

/*
 * publish settings
 */

workflow.output.mode = 'copy'

/*
 * execution profiles for different environments
 */

profiles {
    standard {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
    }

    'all-reads' {
        params.reads = "${projectDir}/data/ggal/ggal_*_{1,2}.fq"
    }

    arm64 {
        process.arch = 'arm64'
    }

    wave {
        wave.enabled = true
        wave.strategy = 'conda'
    }

    'wave-mirror' {
        wave.enabled = true
        wave.strategy = 'container'
        wave.mirror = true
        wave.build.repository = 'quay.io'
    }

    docker {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        docker.enabled = true
    }

    singularity {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        singularity.enabled = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }

    mamba {
        conda.enabled = true
        conda.useMicromamba = true
        conda.channels = ['conda-forge', 'bioconda']
    }

    slurm {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        process.executor = 'slurm'
        /*
         * uncomment and set to a partition of your cluster,
         * otherwise jobs go to the cluster default partition
         */
        // process.queue = 'your-partition'
        singularity.enabled = true
    }

    batch {
        params.reads = 's3://rnaseq-nf/data/ggal/lung_{1,2}.fq'
        params.transcriptome = 's3://rnaseq-nf/data/ggal/transcript.fa'
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        process.executor = 'awsbatch'
        /*
         * replace with your own AWS Batch job queue!
         */
        process.queue = 'nextflow-ci'
        /*
         * replace with your own bucket!
         */
        workDir = 's3://rnaseq-nf/scratch'
        /*
         * set to the region of your job queue and bucket
         */
        aws.region = 'eu-west-1'
        /*
         * path of the AWS CLI on the Batch compute instances,
         * it must be installed in the AMI used by your compute environment
         */
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    }

    's3-data' {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        params.reads = 's3://rnaseq-nf/data/ggal/lung_{1,2}.fq'
        params.transcriptome = 's3://rnaseq-nf/data/ggal/transcript.fa'
    }

    'google-batch' {
        params.transcriptome = 'gs://rnaseq-nf/data/ggal/transcript.fa'
        params.reads = 'gs://rnaseq-nf/data/ggal/gut_{1,2}.fq'
        params.multiqc = 'gs://rnaseq-nf/multiqc'
        process.executor = 'google-batch'
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        /*
         * replace with your own bucket!
         */
        workDir = 'gs://rnaseq-nf/scratch'
        /*
         * set to the region where your Google Batch jobs should run
         */
        google.location = 'europe-west2'
    }

    'gs-data' {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        params.transcriptome = 'gs://rnaseq-nf/data/ggal/transcript.fa'
        params.reads = 'gs://rnaseq-nf/data/ggal/gut_{1,2}.fq'
    }

    'azure-batch' {
        process.container = 'docker.io/nextflow/rnaseq-nf:v1.3.1'
        /*
         * replace with a blob container in your storage account!
         */
        workDir = 'az://nf-scratch/work'
        process.executor = 'azurebatch'
        /*
         * replace with your own Azure pool name!
         */
        process.queue = 'nextflow-ci'

        /*
         * make sure the following variables are defined in your environment
         * - AZURE_BATCH_ACCOUNT_NAME
         * - AZURE_BATCH_ACCOUNT_KEY
         * - AZURE_STORAGE_ACCOUNT_NAME
         * - AZURE_STORAGE_ACCOUNT_KEY
         * see https://www.nextflow.io/docs/latest/azure.html#azure-batch
         */
        azure {
            batch {
                // set to the region of your Batch account
                location = 'westeurope'
                autoPoolMode = true
                deletePoolsOnCompletion = true
            }
        }
    }
}
